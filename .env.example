# --- FRONTEND CONFIGURATION (Exposed to Browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_LOCAL_MEDIA=false

# Comma-separated test accounts that bypass course purchases. NEVER set in production.
NEXT_PUBLIC_BYPASS_EMAILS=

# --- SECURE BACKEND CONFIGURATION (Keep private, never commit to git) ---
SUPABASE_SERVICE_ROLE_KEY=
BAKONG_WEBHOOK_SECRET=

# Bakong KHQR merchant credentials (required by /api/checkout)
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_TYPE=
BAKONG_MERCHANT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=

# Bakong OpenAPI (required by /api/checkout/status polling verification)
BAKONG_API_URL=
BAKONG_ACCESS_TOKEN=

# --- VIDEO HOSTING ---
# Bunny Stream (signed playback). Set these when lessons use source "Bunny Stream".
# Host of your pull zone, e.g. vzn1234.b-cdn.net or video.yourdomain.com
BUNNY_STREAM_PULL_ZONE_HOST=
# Token Authentication key from Bunny dashboard > Stream > Library > Security
BUNNY_STREAM_TOKEN_SECURITY_KEY=
# Set true AFTER enabling "Token IP Validation" on the pull zone: locks each signed
# URL to the viewer's IP so shared links stop working on other connections.
# Requires BUNNY_STREAM_PULL_ZONE_HOST to serve IPv4 (Bunny disables IPv6 with token auth).
BUNNY_STREAM_BIND_TOKEN_IP=false
# Optional: rendition quality used for direct MP4 playback (default 720p). Requires "Allow MP4 renditions" enabled on the library.
BUNNY_STREAM_QUALITY=
# Optional: library id, reserved for upload tooling
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
CLOUDFLARE_STREAM_API_TOKEN=
