# --- FRONTEND CONFIGURATION (Exposed to Browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_LOCAL_MEDIA=false
# Canonical site origin used for sitemap/robots/OG (e.g. https://archtipsbox.com)
NEXT_PUBLIC_SITE_URL=

# Comma-separated test accounts that bypass course purchases. NEVER set in production.
NEXT_PUBLIC_BYPASS_EMAILS=

# --- EMAIL (Resend) ---
# API key from resend.com/api-keys. Without it, emails are skipped silently.
RESEND_API_KEY=
# e.g. "Archtipsbox <noreply@yourdomain.com>" - use Resend sandbox onboarding@resend.dev while testing
EMAIL_FROM=

# --- SECURE BACKEND CONFIGURATION (Keep private, never commit to git) ---
SUPABASE_SERVICE_ROLE_KEY=
BAKONG_WEBHOOK_SECRET=

# Bakong KHQR merchant credentials (required by /api/checkout)
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_TYPE=
BAKONG_MERCHANT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=

# Bakong OpenAPI (required by /api/checkout/status polling verification)
BAKONG_API_URL=
BAKONG_ACCESS_TOKEN=

# --- VIDEO HOSTING ---
# Bunny Stream (signed playback). Set these when lessons use source "Bunny Stream".
# Host of your pull zone, e.g. vzn1234.b-cdn.net or video.yourdomain.com
BUNNY_STREAM_PULL_ZONE_HOST=
# Token Authentication key from your pull zone (CDN > Security > Token Authentication)
BUNNY_STREAM_TOKEN_SECURITY_KEY=
# Delivery format for Bunny lessons: hls (default, recommended) or mp4 (legacy fallback)
BUNNY_STREAM_FORMAT=hls
# Signed URL lifetime in seconds (default 7200 = 2h). Must exceed your longest lesson runtime.
BUNNY_STREAM_TTL_SECONDS=7200
# Optional: rendition quality used only when BUNNY_STREAM_FORMAT=mp4 (max 720p, requires MP4 Fallback enabled)
BUNNY_STREAM_QUALITY=
# Set true AFTER enabling "Token IP Validation" on the pull zone: locks each signed
# URL to the viewer's IP so shared links stop working on other connections.
BUNNY_STREAM_BIND_TOKEN_IP=false
# Optional: library id + API key, reserved for upload tooling
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
CLOUDFLARE_STREAM_API_TOKEN=
